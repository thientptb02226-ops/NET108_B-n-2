@model Lab4.Web.Models.CategoryForm
@{
    ViewData["Title"] = "Thêm danh mục";
}
<h1>Thêm danh mục</h1>
<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="error"></div>
    <label asp-for="Name">Tên danh mục</label>
    <input asp-for="Name" />
    <label><input asp-for="Active" /> Hoạt động</label>
    <p><button type="submit">Lưu</button> <a asp-action="Index">Hủy</a></p>
</form>
