@model List<Lab3.Entities.Category>
@{
    ViewData["Title"] = "Danh mục";
}
<h1>Danh mục sản phẩm</h1>
@if (User.IsInRole("Manager"))
{
    <p><a class="button" asp-action="Create">Thêm danh mục</a></p>
}
@if (Model.Count == 0)
{
    <p>Chưa có danh mục.</p>
}
else
{
    <table>
        <thead><tr><th>ID</th><th>Tên</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td><td>@item.Name</td><td>@(item.Active ? "Hoạt động" : "Ẩn")</td>
                <td class="links">
                    <a asp-action="Details" asp-route-id="@item.Id">Xem</a>
                    @if (User.IsInRole("Manager"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
