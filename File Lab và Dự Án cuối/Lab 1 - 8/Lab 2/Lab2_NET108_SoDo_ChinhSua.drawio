st" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#f8fafc;strokeColor=#9aa6b2;dashed=1;fontColor=#17365d;fontSize=20;" vertex="1" parent="1"><mxGeometry x="540" y="1060" width="390" height="240" as="geometry" /></mxCell><mxCell id="p2-sales" value="Giỏ và đơn hàng&#10;Carts, CartItems&#10;Checkout idempotent&#10;Orders, OrderItems&#10;Đơn pending_payment" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#edf5fc;strokeColor=#315e88;fontColor=#17365d;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1010" y="620" width="390" height="300" as="geometry" /></mxCell><mxCell id="p2-sales_child" value="Giao dịch thật&#10;Payment, shipment, return&#10;Tích hợp ở giai đoạn sau" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#f8fafc;strokeColor=#9aa6b2;dashed=1;fontColor=#17365d;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1010" y="1060" width="390" height="240" as="geometry" /></mxCell><mxCell id="p2-assistant" value="Trợ lý mua sắm&#10;API recommend theo SKU&#10;Kiểm lại giá và tồn từ DB&#10;Model provider có cấu hình" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#edf5fc;strokeColor=#315e88;fontColor=#17365d;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1480" y="620" width="390" height="300" as="geometry" /></mxCell><mxCell id="p2-assistant_child" value="AI mở rộng&#10;Conversation, RAG, tool gateway&#10;Chưa có bảng và pipeline" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#f8fafc;strokeColor=#9aa6b2;dashed=1;fontColor=#17365d;fontSize=20;" vertex="1" parent="1"><mxGeometry x="1480" y="1060" width="390" height="240" as="geometry" /></mxCell><mxCell id="p2-ops" value="Quản trị và tích hợp&#10;UI dashboard chưa có&#10;Mailpit cho mã email&#10;Thanh toán chưa tích hợp" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fil